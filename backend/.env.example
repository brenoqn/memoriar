PORT=3001
FRONTEND_ORIGIN=http://localhost:4200

# PostgreSQL. No desenvolvimento local, `docker compose up -d memoriar-db` sobe um Postgres 17
# compatível com este endereço. Em produção o valor vem do runtime (.secrets/database.env).
DATABASE_URL=postgresql://memoriar_user:memoriar_local_dev@localhost:5432/memoriar_db
DATABASE_POOL_MAX=5

# Segredo de assinatura dos tokens administrativos (mínimo 32 caracteres).
# Gere um valor próprio, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-local-com-32-caracteres-ou-mais
JWT_EXPIRES_IN_MINUTES=480
